# ---------- WebUntis ----------
# Address of your school, as in the browser (without https://)
UNTIS_SERVER=your-school.webuntis.com
UNTIS_USER=
# If the password contains a $, put it in single quotes: UNTIS_PASSWORD='pa$$word'
UNTIS_PASSWORD=

# ---------- Google ----------
# OAuth client of type "TVs and Limited Input devices" (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "primary" = main calendar, or the ID of your own calendar (ends with @group.calendar.google.com)
CALENDAR_ID=primary

# ---------- Language ----------
# Language of the calendar events and the push notifications: en or de (default: en)
# Logs and console output are always English.
# Changing it rewrites all events in the calendar once (without a notification).
LANGUAGE=en

# ---------- Time zone and time range ----------
# Time zone of the school, e.g. Europe/Berlin, Europe/Vienna, Europe/Zurich
TZ=Europe/Berlin
# How many weeks in advance are synced
SYNC_WEEKS_AHEAD=12

# ---------- Schedule ----------
# Either an interval (optionally with a time window) ...
SYNC_INTERVAL_MINUTES=5
SYNC_WINDOW=06:00-19:00
# ... or fixed times (interval and window are ignored then):
# SYNC_TIMES=06:30,12:00,17:30
# Weekdays: 1 = Monday ... 7 = Sunday
SYNC_DAYS=1-5
# Run once immediately when the container starts
SYNC_RUN_ON_START=true
# A hanging run is stopped after this many minutes
SYNC_TIMEOUT_MINUTES=15

# ---------- Notifications (ntfy), empty = none ----------
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# ---------- Cancelled lessons ----------
# Besides the status "cancelled", a lesson also counts as cancelled if one of its info texts
# (info, text, notes, substitution) contains one of these phrases (comma separated, not case sensitive).
# The default is the phrase of the author's German school. Set your school's phrase, if it uses one.
# CANCEL_KEYWORDS=eigenverantwortliches arbeiten

# ---------- Subject names ----------
# The built-in subject table (code -> name) is made for one German school. If your school is NOT that
# one, set this to false and put your own codes into data/fach_map.json (see README, "Subject names").
# FACH_MAP_USE_DEFAULTS=true

# ---------- Docker: user that owns the files in ./data ----------
# Linux: "id -u" and "id -g"
PUID=1000
PGID=1000
