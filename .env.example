# ---------- WebUntis ----------
# Adresse deiner Schule, wie im Browser (ohne https://)
UNTIS_SERVER=your-school.webuntis.com
UNTIS_USER=
# Enthält das Passwort ein $, setze es in einfache Anführungszeichen: UNTIS_PASSWORD='pa$$word'
UNTIS_PASSWORD=

# ---------- Google ----------
# OAuth-Client vom Typ "TVs und Geräte mit eingeschränkter Eingabe" (siehe README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "primary" = Hauptkalender, oder die ID eines eigenen Kalenders (endet auf @group.calendar.google.com)
CALENDAR_ID=primary

# ---------- Zeitzone und Zeitraum ----------
# Zeitzone der Schule, z. B. Europe/Berlin, Europe/Vienna, Europe/Zurich
TZ=Europe/Berlin
# Wie viele Wochen im Voraus synchronisiert wird
SYNC_WEEKS_AHEAD=12

# ---------- Zeitsteuerung ----------
# Entweder Intervall (optional mit Zeitfenster) ...
SYNC_INTERVAL_MINUTES=5
SYNC_WINDOW=06:00-19:00
# ... oder feste Uhrzeiten (dann werden Intervall und Zeitfenster ignoriert):
# SYNC_TIMES=06:30,12:00,17:30
# Wochentage: 1 = Montag ... 7 = Sonntag
SYNC_DAYS=1-5
# Beim Start des Containers einmal sofort ausführen
SYNC_RUN_ON_START=true
# Ein hängender Lauf wird nach so vielen Minuten beendet
SYNC_TIMEOUT_MINUTES=15

# ---------- Benachrichtigungen (ntfy), leer = keine ----------
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# ---------- Fachnamen ----------
# false = nur die eigene fach_map.json verwenden (siehe README)
# FACH_MAP_USE_DEFAULTS=true

# ---------- Docker: Benutzer, dem die Dateien in ./data gehören ----------
# Linux: "id -u" und "id -g"
PUID=1000
PGID=1000